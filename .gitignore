node_modules/

.env
.env.*
!.env.example

*.log
npm-debug.log*

.DS_Store
Thumbs.db

dist/
build/

# api sqlite stores + their wal/shm sidecars. Two very different things live here:
# glub-history.db is a rolling cache and safe to delete, while glub-patrons.db is
# the ONLY record of who paid - never in git, but the one file worth backing up.
*.db
*.db-wal
*.db-shm

# cashu proofs. Not a config file and not a cache: this is bearer ecash, so it is
# the money itself. Never in git - a commit would publish spendable tokens - and
# the one file here worth backing up somewhere private.
glub-proofs.json
*-proofs.json
*-proofs.json.[0-9]
*-proofs.json.tmp
