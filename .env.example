PORT=3000
RELAY_CSV_URL=https://raw.githubusercontent.com/permissionlesstech/bitchat/main/relays/online_relays_gps.csv

# optional history api (npm run api) - see README
API_PORT=3001
# API_DB=api/glub-history.db
# API_BUFFER_MAX=2000   # rolling buffer size (max events kept; oldest pruned)

# ephemeral media uploads (assist-only "+" button). shared media links are
# absolutized by the client against its own (https) origin, so nothing to set for
# a normal same-origin deploy. only set API_PUBLIC_ORIGIN to serve media from a
# DIFFERENT origin (e.g. a dedicated media host/cdn):
# API_PUBLIC_ORIGIN=https://media.glub.chat
# API_MEDIA_MAX_BYTES=10485760   # max upload size (10mb)
# API_MEDIA_MAX_ITEMS=50         # max stored items before oldest are pruned
# API_MEDIA_DIR=api/media-tmp    # wiped on api restart

# optional message translation (assist-only "translate" action in the tap menu).
# defaults to DeepL's free tier; the key stays server-side. leave unset to
# disable translation entirely (the client hides the action).
# TRANSLATE_API_KEY=your-deepl-auth-key
# TRANSLATE_API_URL=https://api-free.deepl.com/v2/translate   # use api.deepl.com for Pro
# TRANSLATE_AUTH_SCHEME=DeepL-Auth-Key                        # e.g. "Bearer" for other providers
# TRANSLATE_TARGETS=ar,de,en,es,fr,...   # override target-language coverage for non-DeepL providers

# optional channel geolocation (the place name under the users list). reverse-
# geocodes a geohash via OpenStreetMap Nominatim - free, no key. results are
# cached forever and calls are spaced to respect the usage policy. set a real
# contact UA for a public deploy (Nominatim policy). the client always shows the
# cell coverage on its own; this only adds the place name.
# GEOCODE_USER_AGENT=glub-chat/1.0 (you@example.com)
# GEOCODE_API_URL=https://nominatim.openstreetmap.org/reverse   # or a self-hosted instance

# when API_PORT (or API_ORIGIN) is set, the static server transparently proxies
# /api -> the api, so the client reaches it same-origin (no CORS, no client
# config). Set API_ORIGIN only if the api runs on a different host:
# API_ORIGIN=http://127.0.0.1:3001

# optional relay set override for the api. defaults to bitchat's published list;
# point it at your own csv (url,lat,lon) to run against a private relay set. an
# unreachable url is non-fatal - the api boots and simply connects to nothing.
# API_RELAY_CSV=https://example.com/my-relays.csv

# optional patronage: a donation buys a nip-05 identity under your domain, driven
# entirely from public bot commands (!donate / !redeem / !nip05). ALL OF IT IS OFF
# unless a backend is configured - with none the bot doesn't offer the commands at
# all, rather than offering them and failing.
#
# TWO BACKENDS, pick one. If both are set the cashu mint wins (running both would
# split donations across two ledgers).
#
# --- option A: a cashu mint (no account anywhere, nothing to self-host) ---
# The bot holds the donations as ecash proofs in PATRON_PROOFS. That FILE IS THE
# MONEY - a bearer token, with no support line and no chargebacks - so the default
# posture is not to hold it: set PATRON_PAYOUT_ADDRESS and anything above the
# threshold is swept out automatically. Without one, funds accumulate on the box.
# Pick a mint yourself - a mint is a custodian, and this file is not the place to
# be told which one to trust. Directories: https://bitcoinmints.com / nutshell's
# list. Two things to check before you point at one:
#
#  - its /v1/info. Mints publish their own terms there, and they mean it -
#    mint.minibits.cash/Bitcoin (a real, working, widely used mint) describes
#    itself as "an active research project in BETA" and "do not use with large
#    amounts of ecash". That is fine for donation float that gets swept out; it
#    is not fine as a place to accumulate.
#  - that it is NOT a test mint. testnut.cashu.space and friends run a FakeWallet
#    that marks EVERY invoice paid, so !donate would hand out a nip-05 to anyone
#    who asked and no money would ever move. Useful for testing this code,
#    catastrophic in production.
# CASHU_MINT_URL=
# PATRON_PAYOUT_ADDRESS=you@yourwallet.com   # lightning address; auto-sweep target
# PATRON_SWEEP_THRESHOLD_SATS=10000          # sweep once the vault passes this
# PATRON_PROOFS=api/glub-proofs.json         # back this up. it is the money.
#
# --- option B: LNbits ---
# use LNbits' INVOICE/read key, never the admin key: it can create invoices and
# read their status, and cannot spend. if it leaks, the worst anyone can do is
# mint invoices payable to you.
# LNBITS_URL=https://legend.lnbits.com
# LNBITS_INVOICE_KEY=your-lnbits-invoice-read-key
#
# --- admin ---
# Admin commands (!vault) are gated centrally: a non-admin gets SILENCE, and the
# commands don't appear in their !help either, so a public channel never learns
# they exist.
#
# Nothing needs setting here. A short code rotates on a timer and is printed as
# the PREFIX on every console line, so it is always on the last line of output
# rather than buried in scrollback; run `!auth <code>` in any channel and your
# pubkey is added to a persisted allow-list. Redeeming rotates the code, so the
# one that just travelled through a public channel is already spent. Terminal
# access is the root credential, which is the point - there is no shared secret
# to keep in sync or to leak.
#
# !shout queues a message for OPPORTUNISTIC delivery: it stays live for a window
# and drops into a channel the first time that channel shows activity, so it only
# lands where somebody is present to read it. Admin-only for now.
# GLUB_SHOUT_WINDOW_SEC=420      # how long a queued shout stays live
# GLUB_SHOUT_MAX_CHANNELS=250    # safety cap on channels reached per shout
# GLUB_SHOUT_INTERVAL_MS=400     # min gap between deliveries, across all shouts
#
# ADMIN_STATE=api/glub-admin.json   # persisted allow-list of redeemed pubkeys
# ADMIN_CODE_TTL_SEC=420            # how long a code lives before rotating
# Optional permanent admins who never need to redeem anything. 64-hex, comma
# separated - NOT npubs. Leave unset and use !auth instead.
# GLUB_ADMIN_PUBKEYS=abc123...
# NIP05_DOMAIN=glub.chat            # the domain identities are issued under
# PATRON_SATS=7760                  # price of a patron identity. fixed sats, so it
#                                   # drifts: $5.00 at $64,424/BTC on 2026-08-06
# PATRON_DB=api/glub-patrons.db     # SEPARATE from the history db, which is a prunable cache
# PATRON_INVOICE_TTL_SEC=3600       # unpaid-invoice window (a cashu mint sets its own,
#                                   # and the SHORTER of the two always wins)
# PATRON_RENAME_COOLDOWN_SEC=604800 # per-pubkey rename rate limit (7d); first rename is free
# PATRON_SWEEP_MS=20000             # how often unpaid invoices are re-checked
